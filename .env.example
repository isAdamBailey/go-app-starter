# Postgres (used by docker-compose to initialize the database container)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Backend (local dev)
# In production PORT is assigned from the server's 81xx port registry
# (face-value 8101, massa 8102, ...) — never left to the default. See docs/DEPLOY.md.
PORT=8080
DATABASE_URL=postgres://app:app@postgres:5432/app?sslmode=disable
APP_BASE_URL=http://localhost:3000

# Session cookies — generate with: openssl rand -base64 32
COOKIE_SIGNING_SECRET=changeme-32-byte-random-secret
COOKIE_SECURE=false

# Email — local dev uses Mailpit (docker-compose)
# Production on the Forge server: SMTP_PORT=2587 (the server can't reach SES on
# 587 or 465; SES also answers on 2587).
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
MAGIC_LINK_FROM_EMAIL=login@app.local

# Comma-separated list of emails allowed to log in
ALLOWED_EMAILS=you@example.com

# Frontend — separate API origin in local dev. In production leave it empty:
# the app calls same-origin /api, and the value is baked in at `npm run generate`.
NUXT_PUBLIC_API_BASE=http://localhost:8080
